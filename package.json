{
  "name": "nalanda",
  "version": "1.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "cloudflare": {
    "bindings": {
      "SESSION_SECRET": {
        "description": "Signs everyone's sign-in cookie. Any long random value: `openssl rand -hex 32` makes one, or a password manager's generator. **Keep a copy**: `/setup` asks for it once, to show it's you setting the library up. Optional tokens (Discogs, BoardGameGeek, Google Books) are added later in the dashboard: [how](https://github.com/isstiaung/nalanda/blob/main/runbooks/deploy.md#one-click-deploy)."
      },
      "DB": {
        "description": "The library itself: items, members, reads, loans and history (D1). Its migrations run on every deploy."
      },
      "COVERS": {
        "description": "Cover images (R2)."
      }
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:demo": "wrangler dev --port 8788 --persist-to .wrangler/demo-state",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/wrangler-remote.mjs d1 migrations apply DB --remote",
    "wrangler:remote": "node scripts/wrangler-remote.mjs",
    "deploy": "node scripts/deploy.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:local": "node scripts/backup.mjs --local",
    "backfill:remote": "node --disable-warning=ExperimentalWarning scripts/backfill-remote.mjs",
    "record-covers:remote": "node --disable-warning=ExperimentalWarning scripts/record-covers.mjs",
    "federation:keygen": "node scripts/federation-keygen.mjs",
    "reset-admin": "node scripts/reset-admin.mjs",
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "a11y": "node scripts/a11y.mjs",
    "demo:build": "node scripts/demo-build.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/eslint-parser": "^8.0.6",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@fontsource/eczar": "^5.3.0",
    "@fontsource/tiro-tamil": "^5.3.0",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "htmx.org": "^2.0.11",
    "playwright": "^1.63.0",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2",
    "vitest": "~4.1.11",
    "wrangler": "^4.142.0",
    "zxing-wasm": "^3.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "undici": "7.29.1"
  }
}
