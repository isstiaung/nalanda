{
  "name": "nalanda",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:demo": "wrangler dev --port 8788 --persist-to .wrangler/demo-state",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply nalanda --local",
    "db:migrate:remote": "wrangler d1 migrations apply nalanda --remote",
    "deploy": "node scripts/deploy.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:local": "node scripts/backup.mjs --local",
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@fontsource/eczar": "^5.3.0",
    "drizzle-kit": "^0.31.0",
    "htmx.org": "^2.0.0",
    "typescript": "^7.0.2",
    "vitest": "~4.1.10",
    "wrangler": "^4.119.0",
    "zxing-wasm": "^3.1.2"
  }
}
