{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nalanda",
  "main": "src/index.ts",
  // Runs before every deploy, version upload and `wrangler dev` (wrangler's custom build). It does nothing but in a
  // household's fork building in Cloudflare (ARCH.md §16 #101): there, on the library's branch, it finds or creates the
  // `nalanda` database and migrates it, so Cloudflare's own deploy command needs no changing — see the script.
  "build": { "command": "node scripts/workers-build.mjs" },
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    // /offline.html is served as /offline.html, not redirected to /offline: the service worker keeps that file
    // under its own name, and a missing one 404s (MISSING_ASSET) instead of reaching the login redirect.
    // These files are served before the Worker runs (no run_worker_first), so their headers come from
    // public/_headers, not from secureHeaders() in src/index.ts.
    "html_handling": "none"
  },
  // No database_id, on purpose: this repo names no specific Cloudflare resource (ARCH.md §16 #24). A deploy finds
  // the database by its name (`nalanda`) — wrangler connects to it, or creates it — and this repository's own deploys
  // write the real id from D1_DATABASE_ID into a copy of this file (scripts/deploy.mjs). `preview_database_id` is the
  // all-zero placeholder local dev has always used: `npm run dev`, local migrations and the tests key their local
  // database by it, so a fresh clone runs offline with nothing to edit. Keep it: changing it re-keys local storage (a
  // populated dev database will look empty until you put the old value back).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nalanda",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COVERS",
      "bucket_name": "nalanda-covers"
    }
  ],
  "observability": {
    "enabled": true
  }
}
