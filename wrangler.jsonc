{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nalanda",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public"
  },
  // database_id is intentionally blank: this repo names no specific Cloudflare
  // resource. Local dev, local migrations, and the tests ignore it entirely, so a
  // fresh clone runs offline without touching it. Deploys read the real id from
  // the D1_DATABASE_ID environment variable — see scripts/deploy.mjs.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nalanda",
      "database_id": "",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "COVERS",
      "bucket_name": "nalanda-covers"
    }
  ],
  "observability": {
    "enabled": true
  }
}
